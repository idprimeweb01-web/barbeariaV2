# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite o .env — ele já está no .gitignore.

# ── Banco de dados ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://usuario:senha@localhost:5432/barberos

# ── Segurança (Flask / JWT) ───────────────────────────────────────────────────
# Gere as duas chaves abaixo com:
#   python -c "import secrets; print(secrets.token_hex(32))"
# NUNCA use um placeholder aqui — app/__init__.py recusa iniciar se detectar
# uma chave curta, com baixa entropia, ou contendo trechos como "changeme",
# "your-secret-key", "substitua" etc.
SECRET_KEY=gere-uma-chave-real-de-32-bytes-com-o-comando-acima
JWT_SECRET_KEY=gere-outra-chave-real-de-32-bytes-com-o-comando-acima

# ── Ambiente ──────────────────────────────────────────────────────────────────
# "production" liga cookies Secure/SameSite estritos — use em qualquer
# ambiente acessível pela internet (inclusive staging). Só use "development"
# em localhost.
FLASK_ENV=development

# ── Cloudinary (upload de imagens: comprovantes PIX, fotos de produto,
# customização visual da barbearia) ───────────────────────────────────────────
# Painel: https://cloudinary.com/console (Settings → Access Keys)
CLOUDINARY_CLOUD_NAME=seu-cloud-name-aqui
CLOUDINARY_API_KEY=sua-api-key-aqui
CLOUDINARY_API_SECRET=seu-api-secret-aqui

# ── Rate limiting (Script 13/Bloco 4.2) ───────────────────────────────────────
# Em produção com mais de 1 worker gunicorn, usar Redis (memory:// é
# por-worker — ver DT-006 / RELATORIO_BLOCO_13.txt).
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=300 per minute
# RL_LOGIN, RL_CADASTRO, RL_AGENDAR, RL_PLANO_SOLICITAR, RL_COMPROVANTE,
# RL_CUPOM_VALIDAR, RL_SLOTS têm defaults sensatos no código — só defina
# aqui se precisar sobrescrever algum.

# ── Seed de administrador (rodar `python seeds_prod.py` em produção,
# NUNCA os scripts de seed de dev) ────────────────────────────────────────────
ADMIN_EMAIL=admin@seudominio.com
ADMIN_SENHA=defina-uma-senha-forte-so-para-o-primeiro-acesso

# ── Opcional: desliga o scheduler de lembretes (usado em testes) ─────────────
# DISABLE_SCHEDULER=1

# ── Bot de agendamento via WhatsApp (Evolution API + n8n, .claude/n8n/) ──────
# Evolution API roda em Docker (.claude/n8n/docker-compose.yml); como o
# barberos roda fora do Docker, usa localhost (não host.docker.internal).
# Mesmo EVOLUTION_API_KEY definido no .env do n8n.
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=

# Production URL do node "Webhook - Evolution Inbound" do workflow
# barberos-bot-whatsapp.json (copiar do n8n depois de importar e ativar).
# É pra ESSA url que toda instância nova é criada apontando.
# ATENÇÃO: essa URL é chamada pelo container evolution-api (não pelo
# barberos), e n8n/evolution-api estão na MESMA rede Docker Compose —
# use o nome do serviço "n8n" como host, NUNCA "localhost" (dentro do
# container evolution-api, localhost aponta pra ele mesmo, não pro n8n;
# o webhook fica registrado mas todo envio falha silenciosamente).
N8N_BOT_WEBHOOK_URL=http://n8n:5678/webhook/barberos-bot

# Secret enviado no header "X-Webhook-Secret" em toda instância nova criada
# (ver app/utils/evolution.py::criar_instancia) — o node "Webhook - Evolution
# Inbound" no n8n exige esse mesmo valor (credencial Header Auth) pra aceitar
# a chamada. Sem isso, qualquer um que descobrisse a URL do webhook do bot
# conseguiria forjar mensagem de WhatsApp e gastar sua cota de IA de graça.
# Gere com: openssl rand -hex 24. MESMO valor tem que estar no .env do n8n
# (.claude/n8n/.env, mesma chave N8N_BOT_WEBHOOK_SECRET).
N8N_BOT_WEBHOOK_SECRET=

# Direção OPOSTA do N8N_BOT_WEBHOOK_SECRET acima: esse aqui autentica o n8n
# CHAMANDO DE VOLTA pro barberos (app/routes/pub/whatsapp.py — resolver
# barbearia pela instância, consultar próximo agendamento do cliente por
# telefone). Sem essa variável definida, as duas rotas negam TODO mundo,
# inclusive o próprio n8n (falha fechado por design — ver
# AUDITORIA_PRODUCAO.md achado #2). O n8n precisa mandar o mesmo valor no
# header "X-Bot-Secret" em toda chamada pra esses dois endpoints.
# Gere com: openssl rand -hex 24. MESMO valor tem que estar configurado nos
# nodes HTTP Request do workflow barberos-bot-whatsapp.json que chamam
# barbearia-por-instancia e proximo-agendamento.
N8N_BOT_API_SECRET=
